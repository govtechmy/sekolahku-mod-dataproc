FROM python:3.13.8-slim

# Python runtime settings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AWS_SECRETS_NAME=sekolahku-mod-dataproc-secret-dev

WORKDIR /app

# System dependencies for common scientific and crypto libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libffi-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip setuptools wheel

# Install pinned Python dependencies first for better layer caching
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

ENV PORT=8000 
EXPOSE 8000

# Copy project source code
COPY src /app/src

# Run as an unprivileged user (security assessment F-08). The app only reads
# /app and sends its output to S3/MongoDB, so the root-owned source stays
# read-only to it; libraries that need scratch space use the world-writable /tmp.
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app
# fastapi-crons keeps job state in SQLite, by default ./cron_state.db (= /app,
# read-only for uid 10001); without this every job fails with "unable to open
# database file" when it comes due. The file was already per-container before.
ENV CRON_SQLITE_DB_PATH=/tmp/cron_state.db
USER 10001:10001

# Default command runs the FastAPI server
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
